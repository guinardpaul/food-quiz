<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260524-add-visual-question-fields" author="guinardpaul">
        <addColumn tableName="questions">
            <column name="image_url" type="varchar(500)" />
            <column name="food_name" type="varchar(255)" />
            <column name="portion_description" type="varchar(255)" />
            <column name="equivalents" type="json" />
            <column name="glycemic_impact" type="varchar(20)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
